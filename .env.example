# ── Base de données ───────────────────────────────────────────────
DATABASE_URL="postgresql://teranga:teranga@localhost:5432/teranga?schema=public"

# ── Application ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Connexion à la console (sessions) ─────────────────────────────
SESSION_IDLE_HOURS=12            # inactivité maximale ; la console ouverte prolonge la session
SESSION_MAX_DAYS=7               # durée de vie maximale d'une session
# Derrière ngrok ou un hébergeur : nombre de proxys de confiance (ex. 1). Vide = désactivé.
# Sans cela, la limitation par IP de la connexion voit l'adresse du proxy pour tout le monde.
TRUST_PROXY=

# ── Règles métier / tarification (modifiables sans redéploiement) ──
COMMISSION_RATE=0.18
DEFAULT_ACCOMPANIMENT_FEE_FCFA=7500
PMR_VEHICLE_SURCHARGE_RATE=0.20
VIP_SURCHARGE_RATE=0.15

# ── Barème au compteur (trajets libres) ───────────────────────────
METER_BASE_FARE_FCFA=1000        # prise en charge
METER_PER_KM_FCFA=350            # prix par kilomètre
METER_PER_MINUTE_FCFA=50         # prix par minute
METER_MINIMUM_FARE_FCFA=2000     # minimum de course
ESTIMATED_AVG_SPEED_KMH=30       # vitesse moyenne (estime la durée sans carte)
AUTOROUTE_TOLL_FCFA=1500         # péage autoroute Dakar–Diamniadio–AIBD

# ── Google Maps (géocodage, itinéraires, péages) ──────────────────
GOOGLE_MAPS_API_KEY=

# ── Paiement mobile ───────────────────────────────────────────────
PAYMENT_AGGREGATOR=PAYDUNYA
PAYDUNYA_MODE=test               # test (sandbox) ou live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME="Teranga Mobility"
# URL publique de l'IPN, préfixe /api compris (en local : domaine ngrok)
PAYDUNYA_IPN_URL=https://exemple.ngrok-free.dev/api/payments/paydunya/ipn
WAVE_API_KEY=

# ── SMS (confirmations clients sans smartphone) ───────────────────
SMS_PROVIDER=
SMS_API_KEY=
