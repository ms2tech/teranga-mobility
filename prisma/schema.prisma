// ════════════════════════════════════════════════════════════════════════
//  Téranga Mobility — Modèle de données
//  Plateforme de réservation de transport porte-à-porte adapté au Sénégal
//  (PMR, médical non urgent, seniors, VIP aéroport — desserte AIBD)
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Énumérations ────────────────────────────────────────────────────────

enum UserRole {
  ADMIN // tout, plus : annuler une confirmation, rembourser, corriger un prix, tarifs, comptes du personnel
  MANAGER // responsable des opérations : tout l'OPERATOR + confirmation manuelle d'un paiement + panneau « À régler »
  OPERATOR // centrale téléphonique : réservations, affectation, liens de paiement, vérification
  DRIVER // chauffeur partenaire
  CLIENT // compte client (optionnel — beaucoup réservent par téléphone)
}

enum ServiceType {
  MEDICAL_NON_URGENT // dialyse, rééducation, consultations
  PMR // personne à mobilité réduite
  SENIOR // accompagnement personne âgée
  VIP_AIRPORT // transfert premium vers l'aéroport
}

// Besoins spécifiques du passager (profil d'accessibilité)
enum MobilityNeed {
  NONE
  WHEELCHAIR // fauteuil roulant -> impose un véhicule adapté
  WALKING_DIFFICULTY // difficultés de marche
  VISUAL_IMPAIRMENT // déficience visuelle
  STRETCHER // brancard / position allongée
}

// Sens du trajet (la tarification est symétrique ville <-> AIBD)
enum TripDirection {
  TO_AIRPORT // ville -> AIBD (pertinent uniquement pour un corridor aéroport)
  FROM_AIRPORT // AIBD -> ville
  CITY_TO_CITY // trajet libre intra/inter-ville
}

// Comment le prix d'une course est déterminé.
enum PricingMode {
  FLAT // prix fixe d'un corridor connu (ex. Dakar <-> AIBD)
  METERED // au compteur : prise en charge + km + minutes
}

// Motif du déplacement (le transport ne se limite pas à l'aéroport).
enum TripPurpose {
  AIRPORT // transfert aéroport (AIBD)
  MEDICAL // hôpital, dialyse, consultation, rééducation
  ERRANDS // courses, démarches, sorties
  OTHER // autre
}

enum BookingChannel {
  PHONE // centrale téléphonique (canal principal Phase 1)
  WEB // site / PWA
  APP // application mobile (Phase 2)
}

enum BookingStatus {
  PENDING // créée, en attente de confirmation
  CONFIRMED // confirmée auprès du client
  ASSIGNED // chauffeur + véhicule affectés
  EN_ROUTE // chauffeur en route vers le point de prise en charge
  IN_PROGRESS // course en cours (passager à bord)
  COMPLETED // course terminée
  CANCELLED // annulée
  NO_SHOW // passager absent
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  CASH
  CARD
  OTHER // seule option d'une confirmation manuelle : l'argent est reçu, la note dit comment
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED // lien remplacé par une confirmation manuelle, ou confirmation manuelle annulée par un admin
}

// D'où vient l'encaissement : l'agrégateur (PayDunya) ou une confirmation manuelle.
enum PaymentSource {
  GATEWAY
  MANUAL
}

enum PayoutStatus {
  PENDING // dû au chauffeur, pas encore versé
  PROCESSING // inclus dans un lot Wave Bulk Pay en cours
  PAID
  FAILED
}

enum VehicleType {
  SEDAN
  SUV
  MINIVAN
}

enum DriverStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ── Comptes & personnes ─────────────────────────────────────────────────

// Compte authentifiable : personnel (admin/opérateur), chauffeurs, et
// optionnellement les clients qui créent un compte.
model User {
  id           String    @id @default(cuid())
  phone        String    @unique // identifiant principal au Sénégal
  email        String?   @unique // identifiant de connexion du personnel (en minuscules)
  passwordHash String? // argon2id (chaîne complète) ; null = connexion par mot de passe impossible
  fullName     String
  role         UserRole
  isActive     Boolean   @default(true)
  // Pas de verrouillage de compte, volontairement : un opérateur ne doit jamais
  // être bloqué (transport médical). Seule la limitation par IP freine les abus.
  lastLoginAt        DateTime?
  mustChangePassword Boolean   @default(false) // mot de passe temporaire à changer à la 1re connexion
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  driver           Driver?
  clientProfile    Client?
  bookingsCreated  Booking[] @relation("BookingCreatedBy")
  sessions         Session[]
  paymentsConfirmed Payment[] @relation("PaymentConfirmedBy")
  paymentsVoided    Payment[] @relation("PaymentVoidedBy")
  paymentsRefunded  Payment[] @relation("PaymentRefundedBy")
  bookingsCancelled Booking[] @relation("BookingCancelledBy")
  waiversGranted    DepartureWaiver[] @relation("WaiverGrantedBy")
  waiversRevoked    DepartureWaiver[] @relation("WaiverRevokedBy")
  tariffVersionsCreated TariffVersion[] @relation("TariffVersionCreatedBy")
  routeChanges      RouteChange[] @relation("RouteChangedBy")
  driverChanges     DriverChange[] @relation("DriverChangedBy")

  @@index([role])
}

// Session de connexion. Le jeton (aléatoire, 32 octets) n'est jamais stocké :
// seul son hash SHA-256 l'est. Porté par un cookie HttpOnly (console web) ;
// plus tard aussi par l'en-tête Authorization: Bearer (applications mobiles).
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime // glissante (inactivité), plafonnée à createdAt + durée maximale
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

// Le passager. Peut exister sans compte User (réservation par un proche
// via la centrale téléphonique).
model Client {
  id           String         @id @default(cuid())
  fullName     String
  phone        String
  email        String?
  mobilityNeed MobilityNeed   @default(NONE)
  notes        String? // contexte médical, préférences, point de repère domicile
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  bookings Booking[]

  @@index([phone])
}

model Driver {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id])
  status            DriverStatus @default(PENDING_APPROVAL)
  firstAidCertified Boolean      @default(false) // formé aux premiers secours
  // Taux de commission spécifique au chauffeur ; sinon valeur globale (.env)
  commissionRate    Float?
  // Numéro Wave pour recevoir les reversements (Bulk Pay)
  payoutWavePhone   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  vehicles Vehicle[]
  bookings Booking[]
  payouts  DriverPayout[]
  changesFrom DriverChange[] @relation("DriverChangeFrom") // courses qu'il a quittées (panne, incident)
  changesTo   DriverChange[] @relation("DriverChangeTo") // courses qu'il a reprises

  @@index([status])
}

model Vehicle {
  id                   String      @id @default(cuid())
  registration         String      @unique // immatriculation
  type                 VehicleType
  model                String? // ex. "Toyota HiAce"
  seats                Int         @default(4)
  wheelchairAccessible Boolean     @default(false) // rampe / plancher surbaissé
  hasAirConditioning   Boolean     @default(true)
  driverId             String?
  driver               Driver?     @relation(fields: [driverId], references: [id])
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  bookings Booking[]
  changesFrom DriverChange[] @relation("DriverChangeFromVehicle")
  changesTo   DriverChange[] @relation("DriverChangeToVehicle")
}

// ── Réseau & tarification ───────────────────────────────────────────────

// Un corridor à prix fixe : ville <-> AIBD, ou ville <-> ville. Le prix de base est
// symétrique ; le sens est porté par la réservation. Un corridor n'est JAMAIS supprimé :
// des réservations y font référence, on le désactive (isActive). Chaque changement (création,
// prix, désactivation, réactivation) passe par un ADMIN avec un motif et ajoute une ligne
// RouteChange (jamais modifiée). Les prix des réservations existantes restent figés.
model Route {
  id                  String   @id @default(cuid())
  code                String   @unique // ex. "DKR-AIBD", "THS-TBA" ; ne change jamais
  city                String // ville de l'axe, pour le tri et l'affichage (ex. "Dakar")
  label               String // ex. "Dakar <-> AIBD", "Thiès <-> Touba"
  basePriceFcfa       Int // prix facturé (course standard)
  priceMinFcfa        Int // borne basse indicative
  priceMaxFcfa        Int // borne haute indicative
  estimatedDurationMin Int? // durée estimée
  isActive            Boolean  @default(true)
  // Incrémentée à chaque changement : deux admins ne s'écrasent pas (409 si périmée).
  version             Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bookings Booking[]
  changes  RouteChange[]
}

enum RouteChangeKind {
  CREATED
  UPDATED // prix et / ou durée
  DEACTIVATED
  REACTIVATED
}

// Historique d'un corridor : qui, quand, pourquoi, anciennes et nouvelles valeurs.
// Jamais modifiée ni supprimée. Les valeurs « old* » sont vides à la création.
model RouteChange {
  id      String          @id @default(cuid())
  routeId String
  route   Route           @relation(fields: [routeId], references: [id])
  kind    RouteChangeKind
  version Int // version du corridor obtenue après ce changement

  oldBasePriceFcfa        Int?
  oldPriceMinFcfa         Int?
  oldPriceMaxFcfa         Int?
  oldEstimatedDurationMin Int?
  oldIsActive             Boolean?

  basePriceFcfa        Int
  priceMinFcfa         Int
  priceMaxFcfa         Int
  estimatedDurationMin Int?
  isActive             Boolean

  reason      String
  changedById String
  changedBy   User     @relation("RouteChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([routeId])
}

// Barème des trajets libres, par version. Une version n'est JAMAIS modifiée ni supprimée :
// modifier les tarifs crée une nouvelle version (motif et auteur obligatoires). La version
// courante est la plus haute. Un changement ne s'applique qu'aux nouvelles réservations :
// les prix déjà calculés restent figés dans la réservation. La version 1 (createdById
// vide) reprend les valeurs du .env au premier démarrage ; ensuite le .env n'a plus d'effet.
model TariffVersion {
  id      String @id @default(cuid())
  version Int    @unique

  // Barème au compteur
  meterBaseFareFcfa    Int // prise en charge
  meterPerKmFcfa       Int // prix par kilomètre
  meterPerMinuteFcfa   Int // prix par minute
  meterMinimumFareFcfa Int // minimum de course
  estimatedAvgSpeedKmh Float // vitesse moyenne : estime la durée quand la carte ne la fournit pas
  autorouteTollFcfa    Int // péage autoroute (non commissionné)

  // Majorations, accompagnement, commission (taux en fraction : 0.18 = 18 %)
  pmrVehicleSurchargeRate     Float
  vipSurchargeRate            Float
  defaultAccompanimentFeeFcfa Int
  commissionRate              Float

  reason      String
  createdById String?
  createdBy   User?    @relation("TariffVersionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  bookings Booking[]
}

// ── Réservations ────────────────────────────────────────────────────────

model Booking {
  id        String @id @default(cuid())
  reference String @unique // code lisible, ex. "TM-2K6F3A"

  // Qui voyage
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Qui a réservé (souvent un proche, depuis la diaspora)
  bookedByName  String?
  bookedByPhone String?
  channel       BookingChannel @default(PHONE)

  // Trajet (porte-à-porte : n'importe quelle adresse vers n'importe quelle adresse)
  tripPurpose     TripPurpose   @default(OTHER)
  // Corridor à prix fixe (facultatif). Renseigné -> tarification FLAT.
  routeId         String?
  route           Route?        @relation(fields: [routeId], references: [id])
  direction       TripDirection? // pertinent surtout pour un corridor aéroport
  pickupAddress   String
  pickupLat       Float?
  pickupLng       Float?
  dropoffAddress  String
  dropoffLat      Float?
  dropoffLng      Float?
  // Mesure du trajet (renseignée par la carte) -> base de la tarification au compteur
  distanceMeters  Int?
  durationSeconds Int?
  // Quand : immédiat (« dès que possible ») ou planifié
  isImmediate     Boolean       @default(false)
  scheduledAt     DateTime? // heure de prise en charge souhaitée (si planifié)
  flightNumber    String? // pour les transferts aéroport
  flightTime      DateTime?
  passengersCount Int           @default(1)

  // Nature du service & accessibilité
  serviceType         ServiceType
  mobilityNeed        MobilityNeed @default(NONE)
  needsWheelchairVehicle Boolean   @default(false) // déclenche +20 %
  withAccompaniment   Boolean      @default(false) // accompagnement jusqu'à l'enregistrement

  // Affectation
  status     BookingStatus @default(PENDING)
  driverId   String?
  driver     Driver?       @relation(fields: [driverId], references: [id])
  vehicleId  String?
  vehicle    Vehicle?      @relation(fields: [vehicleId], references: [id])

  // Tarification figée à la réservation (FCFA) : le prix ne change jamais après l'accord
  // du client (si le trajet change vraiment, on annule et on recrée la réservation).
  // tariffVersion : version du barème avec laquelle le prix a été calculé (vide avant les
  // tarifs en base).
  tariffVersionId    String?
  tariffVersion      TariffVersion? @relation(fields: [tariffVersionId], references: [id])
  pricingMode        PricingMode @default(FLAT)
  baseFareFcfa       Int // prise en charge (METERED) ou prix du corridor (FLAT)
  distanceFareFcfa   Int @default(0) // part distance (METERED)
  timeFareFcfa       Int @default(0) // part durée (METERED)
  tollFcfa           Int @default(0) // péage (autoroute) — répercuté au chauffeur
  pmrSurchargeFcfa   Int @default(0)
  accompanimentFcfa  Int @default(0)
  vipSurchargeFcfa   Int @default(0)
  totalPriceFcfa     Int

  // Répartition modèle partenaire
  commissionRate     Float
  commissionFcfa     Int
  driverPayoutFcfa   Int

  // Paiement
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod?

  notes       String?
  createdById String? // User (opérateur/admin) ayant saisi la réservation
  createdBy   User?   @relation("BookingCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?
  // Annulation (statut CANCELLED) : motif obligatoire, auteur et date
  cancelledAt  DateTime?
  cancelReason String?
  cancelledById String?
  cancelledBy   User?   @relation("BookingCancelledBy", fields: [cancelledById], references: [id])

  payments         Payment[]
  departureWaivers DepartureWaiver[]
  driverChanges    DriverChange[]
  payout           DriverPayout?

  @@index([status])
  @@index([scheduledAt])
  @@index([clientId])
  @@index([driverId])
}

// Dérogation de départ : un MANAGER ou un ADMIN autorise le départ d'une course
// NON payée (client de confiance, convention avec un hôpital, sortie d'hôpital…),
// avec un motif obligatoire. La course reste non payée : elle figure dans « À régler »
// comme « à encaisser » jusqu'au paiement. Les lignes ne sont jamais effacées : un
// retrait (avant le départ) ajoute revoked*, et une nouvelle dérogation est une
// nouvelle ligne. Au plus une dérogation active (revokedAt nul) par course.
model DepartureWaiver {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  reason      String
  grantedById String
  grantedBy   User     @relation("WaiverGrantedBy", fields: [grantedById], references: [id])
  grantedAt   DateTime @default(now())

  revokedById  String?
  revokedBy    User?     @relation("WaiverRevokedBy", fields: [revokedById], references: [id])
  revokedAt    DateTime?
  revokeReason String?

  @@index([bookingId])
}

// Changement de chauffeur (et / ou de véhicule) sur une course EN ROUTE ou EN COURS : panne,
// incident… Tout le personnel peut le faire, avec un motif obligatoire. La ligne n'est JAMAIS
// modifiée ni supprimée. La course garde son statut, son paiement et son prix (prix figé).
// Le partage de la part chauffeur (driverPayoutFcfa) entre l'ancien et le nouveau chauffeur
// n'est PAS décidé : il le sera au lot des reversements (DriverPayout). Ici, seul l'historique.
model DriverChange {
  id            String        @id @default(cuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id])
  bookingStatus BookingStatus // statut de la course à ce moment-là (EN_ROUTE ou IN_PROGRESS)

  // Avant : vides seulement si la course n'avait pas de chauffeur (donnée ancienne)
  fromDriverId  String?
  fromDriver    Driver?  @relation("DriverChangeFrom", fields: [fromDriverId], references: [id])
  fromVehicleId String?
  fromVehicle   Vehicle? @relation("DriverChangeFromVehicle", fields: [fromVehicleId], references: [id])
  // Après
  toDriverId    String
  toDriver      Driver  @relation("DriverChangeTo", fields: [toDriverId], references: [id])
  toVehicleId   String
  toVehicle     Vehicle @relation("DriverChangeToVehicle", fields: [toVehicleId], references: [id])

  reason      String
  changedById String
  changedBy   User     @relation("DriverChangedBy", fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([bookingId])
}

// Encaissement client : tentative via l'agrégateur (PayDunya) ou confirmation
// manuelle (source MANUAL, toujours method OTHER). Une réservation peut en avoir
// plusieurs (lien expiré, paiement échoué, confirmation annulée puis refaite…).
//
// Les lignes ne sont JAMAIS modifiées dans leur montant ni supprimées : une
// erreur se corrige par une annulation (voided*) ou un remboursement (refunded*),
// avec motif et auteur, et l'historique reste complet. Aucun chauffeur n'encaisse :
// tout l'argent est reçu par la société, qui reverse ensuite sa part au chauffeur.
model Payment {
  id          String         @id @default(cuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id])
  amountFcfa  Int // toujours égal au total de la course (pas de paiement partiel)
  method      PaymentMethod? // connu seulement après le paiement ; OTHER pour une confirmation manuelle
  source      PaymentSource  @default(GATEWAY)
  provider    String? // ex. "PAYDUNYA", "SENEPAY" ; null pour une confirmation manuelle
  providerRef String?        @unique // token de facture côté agrégateur
  paymentUrl  String? // lien de paiement envoyé au client
  receiptUrl  String? // reçu fourni par l'agrégateur
  status      PaymentStatus  @default(PENDING)
  paidAt      DateTime? // date de réception de l'argent
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Confirmation manuelle
  reference     String? // facultative (n° de transaction, de reçu…) ; unique si renseignée, parmi les paiements non annulés
  note          String? // obligatoire pour une confirmation manuelle : comment l'argent a été reçu
  confirmedById String?
  confirmedBy   User?     @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?

  // Annulation d'une confirmation manuelle (ADMIN)
  voidedById String?
  voidedBy   User?     @relation("PaymentVoidedBy", fields: [voidedById], references: [id])
  voidedAt   DateTime?
  voidReason String?

  // Remboursement fait à la main (ADMIN), hors application
  refundedById    String?
  refundedBy      User?     @relation("PaymentRefundedBy", fields: [refundedById], references: [id])
  refundedAt      DateTime?
  refundReason    String?
  refundReference String?

  // Argent reçu alors que la course était déjà payée (ex. lien PayDunya payé après
  // une confirmation manuelle) : la ligne est PAID, ne touche pas la course, et doit
  // être remboursée.
  isDuplicate Boolean @default(false)

  @@index([bookingId])
  @@index([reference])
}

// Reversement de la part chauffeur (Wave Bulk Pay, lots)
model DriverPayout {
  id         String       @id @default(cuid())
  bookingId  String       @unique
  booking    Booking      @relation(fields: [bookingId], references: [id])
  driverId   String
  driver     Driver       @relation(fields: [driverId], references: [id])
  amountFcfa Int
  status     PayoutStatus @default(PENDING)
  batchId    String? // identifiant du lot Bulk Pay
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
  @@index([driverId])
}
