// ════════════════════════════════════════════════════════════════════════
//  Téranga Mobility — Modèle de données
//  Plateforme de réservation de transport porte-à-porte adapté au Sénégal
//  (PMR, médical non urgent, seniors, VIP aéroport — desserte AIBD)
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Énumérations ────────────────────────────────────────────────────────

enum UserRole {
  ADMIN // accès complet, configuration, finances
  OPERATOR // centrale téléphonique : crée/gère les réservations
  DRIVER // chauffeur partenaire
  CLIENT // compte client (optionnel — beaucoup réservent par téléphone)
}

enum ServiceType {
  MEDICAL_NON_URGENT // dialyse, rééducation, consultations
  PMR // personne à mobilité réduite
  SENIOR // accompagnement personne âgée
  VIP_AIRPORT // transfert premium vers l'aéroport
}

// Besoins spécifiques du passager (profil d'accessibilité)
enum MobilityNeed {
  NONE
  WHEELCHAIR // fauteuil roulant -> impose un véhicule adapté
  WALKING_DIFFICULTY // difficultés de marche
  VISUAL_IMPAIRMENT // déficience visuelle
  STRETCHER // brancard / position allongée
}

// Sens du trajet (la tarification est symétrique ville <-> AIBD)
enum TripDirection {
  TO_AIRPORT // ville -> AIBD (pertinent uniquement pour un corridor aéroport)
  FROM_AIRPORT // AIBD -> ville
  CITY_TO_CITY // trajet libre intra/inter-ville
}

// Comment le prix d'une course est déterminé.
enum PricingMode {
  FLAT // prix fixe d'un corridor connu (ex. Dakar <-> AIBD)
  METERED // au compteur : prise en charge + km + minutes
}

// Motif du déplacement (le transport ne se limite pas à l'aéroport).
enum TripPurpose {
  AIRPORT // transfert aéroport (AIBD)
  MEDICAL // hôpital, dialyse, consultation, rééducation
  ERRANDS // courses, démarches, sorties
  OTHER // autre
}

enum BookingChannel {
  PHONE // centrale téléphonique (canal principal Phase 1)
  WEB // site / PWA
  APP // application mobile (Phase 2)
}

enum BookingStatus {
  PENDING // créée, en attente de confirmation
  CONFIRMED // confirmée auprès du client
  ASSIGNED // chauffeur + véhicule affectés
  EN_ROUTE // chauffeur en route vers le point de prise en charge
  IN_PROGRESS // course en cours (passager à bord)
  COMPLETED // course terminée
  CANCELLED // annulée
  NO_SHOW // passager absent
}

enum PaymentMethod {
  WAVE
  ORANGE_MONEY
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING // dû au chauffeur, pas encore versé
  PROCESSING // inclus dans un lot Wave Bulk Pay en cours
  PAID
  FAILED
}

enum VehicleType {
  SEDAN
  SUV
  MINIVAN
}

enum DriverStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ── Comptes & personnes ─────────────────────────────────────────────────

// Compte authentifiable : personnel (admin/opérateur), chauffeurs, et
// optionnellement les clients qui créent un compte.
model User {
  id           String    @id @default(cuid())
  phone        String    @unique // identifiant principal au Sénégal
  email        String?   @unique
  passwordHash String?
  fullName     String
  role         UserRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  driver           Driver?
  clientProfile    Client?
  bookingsCreated  Booking[] @relation("BookingCreatedBy")

  @@index([role])
}

// Le passager. Peut exister sans compte User (réservation par un proche
// via la centrale téléphonique).
model Client {
  id           String         @id @default(cuid())
  fullName     String
  phone        String
  email        String?
  mobilityNeed MobilityNeed   @default(NONE)
  notes        String? // contexte médical, préférences, point de repère domicile
  userId       String?        @unique
  user         User?          @relation(fields: [userId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  bookings Booking[]

  @@index([phone])
}

model Driver {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id])
  status            DriverStatus @default(PENDING_APPROVAL)
  firstAidCertified Boolean      @default(false) // formé aux premiers secours
  // Taux de commission spécifique au chauffeur ; sinon valeur globale (.env)
  commissionRate    Float?
  // Numéro Wave pour recevoir les reversements (Bulk Pay)
  payoutWavePhone   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  vehicles Vehicle[]
  bookings Booking[]
  payouts  DriverPayout[]

  @@index([status])
}

model Vehicle {
  id                   String      @id @default(cuid())
  registration         String      @unique // immatriculation
  type                 VehicleType
  model                String? // ex. "Toyota HiAce"
  seats                Int         @default(4)
  wheelchairAccessible Boolean     @default(false) // rampe / plancher surbaissé
  hasAirConditioning   Boolean     @default(true)
  driverId             String?
  driver               Driver?     @relation(fields: [driverId], references: [id])
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  bookings Booking[]
}

// ── Réseau & tarification ───────────────────────────────────────────────

// Un axe desservi (ville <-> AIBD). Le prix de base est symétrique ;
// le sens est porté par la réservation.
model Route {
  id                  String   @id @default(cuid())
  code                String   @unique // ex. "DKR-AIBD"
  city                String // ex. "Dakar"
  label               String // ex. "Dakar <-> AIBD"
  basePriceFcfa       Int // prix facturé (course standard)
  priceMinFcfa        Int // borne basse indicative
  priceMaxFcfa        Int // borne haute indicative
  estimatedDurationMin Int? // durée estimée
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  bookings Booking[]
}

// ── Réservations ────────────────────────────────────────────────────────

model Booking {
  id        String @id @default(cuid())
  reference String @unique // code lisible, ex. "TM-2K6F3A"

  // Qui voyage
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Qui a réservé (souvent un proche, depuis la diaspora)
  bookedByName  String?
  bookedByPhone String?
  channel       BookingChannel @default(PHONE)

  // Trajet (porte-à-porte : n'importe quelle adresse vers n'importe quelle adresse)
  tripPurpose     TripPurpose   @default(OTHER)
  // Corridor à prix fixe (facultatif). Renseigné -> tarification FLAT.
  routeId         String?
  route           Route?        @relation(fields: [routeId], references: [id])
  direction       TripDirection? // pertinent surtout pour un corridor aéroport
  pickupAddress   String
  pickupLat       Float?
  pickupLng       Float?
  dropoffAddress  String
  dropoffLat      Float?
  dropoffLng      Float?
  // Mesure du trajet (renseignée par la carte) -> base de la tarification au compteur
  distanceMeters  Int?
  durationSeconds Int?
  // Quand : immédiat (« dès que possible ») ou planifié
  isImmediate     Boolean       @default(false)
  scheduledAt     DateTime? // heure de prise en charge souhaitée (si planifié)
  flightNumber    String? // pour les transferts aéroport
  flightTime      DateTime?
  passengersCount Int           @default(1)

  // Nature du service & accessibilité
  serviceType         ServiceType
  mobilityNeed        MobilityNeed @default(NONE)
  needsWheelchairVehicle Boolean   @default(false) // déclenche +20 %
  withAccompaniment   Boolean      @default(false) // accompagnement jusqu'à l'enregistrement

  // Affectation
  status     BookingStatus @default(PENDING)
  driverId   String?
  driver     Driver?       @relation(fields: [driverId], references: [id])
  vehicleId  String?
  vehicle    Vehicle?      @relation(fields: [vehicleId], references: [id])

  // Tarification figée à la réservation (FCFA)
  pricingMode        PricingMode @default(FLAT)
  baseFareFcfa       Int // prise en charge (METERED) ou prix du corridor (FLAT)
  distanceFareFcfa   Int @default(0) // part distance (METERED)
  timeFareFcfa       Int @default(0) // part durée (METERED)
  tollFcfa           Int @default(0) // péage (autoroute) — répercuté au chauffeur
  pmrSurchargeFcfa   Int @default(0)
  accompanimentFcfa  Int @default(0)
  vipSurchargeFcfa   Int @default(0)
  totalPriceFcfa     Int

  // Répartition modèle partenaire
  commissionRate     Float
  commissionFcfa     Int
  driverPayoutFcfa   Int

  // Paiement
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod?

  notes       String?
  createdById String? // User (opérateur/admin) ayant saisi la réservation
  createdBy   User?   @relation("BookingCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?
  cancelledAt DateTime?

  payments Payment[]
  payout   DriverPayout?

  @@index([status])
  @@index([scheduledAt])
  @@index([clientId])
  @@index([driverId])
}

// Tentative d'encaissement client (via agrégateur : Wave / Orange Money / carte).
// Une réservation peut en avoir plusieurs (lien expiré, paiement échoué, etc.).
model Payment {
  id          String         @id @default(cuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id])
  amountFcfa  Int
  method      PaymentMethod? // connu seulement après le paiement
  provider    String? // ex. "PAYDUNYA", "SENEPAY"
  providerRef String?        @unique // token de facture côté agrégateur
  paymentUrl  String? // lien de paiement envoyé au client
  receiptUrl  String? // reçu fourni par l'agrégateur
  status      PaymentStatus  @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([bookingId])
}

// Reversement de la part chauffeur (Wave Bulk Pay, lots)
model DriverPayout {
  id         String       @id @default(cuid())
  bookingId  String       @unique
  booking    Booking      @relation(fields: [bookingId], references: [id])
  driverId   String
  driver     Driver       @relation(fields: [driverId], references: [id])
  amountFcfa Int
  status     PayoutStatus @default(PENDING)
  batchId    String? // identifiant du lot Bulk Pay
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
  @@index([driverId])
}
